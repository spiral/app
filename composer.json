{
    "name": "spiral/app",
    "type": "project",
    "license": "MIT",
    "description": "Spiral Skeleton Application",
    "homepage": "https://spiral.dev",
    "support": {
        "issues": "https://github.com/spiral/app/issues",
        "source": "https://github.com/spiral/app"
    },
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "ext-sockets": "*",
        "cycle/entity-behavior": "^1.8",
        "cycle/transaction": "^1.1",
        "doctrine/collections": "^2.3 || ^3.1",
        "roadrunner/cli": "^3.0.1",
        "spiral-packages/league-event": "^1.0.1",
        "spiral-packages/yii-error-handler-bridge": "^1.2",
        "spiral/cycle-bridge": "^2.13",
        "spiral/framework": "^3.18",
        "spiral/http": "^3.18",
        "spiral/nyholm-bridge": "^1.3",
        "spiral/roadrunner-bridge": "^5.0",
        "spiral/stempler-bridge": "^3.18",
        "spiral/translator": "^3.18"
    },
    "require-dev": {
        "buggregator/trap": "^1.22",
        "internal/dload": "^1.19",
        "llm/skills": "^1.23",
        "spiral/code-style": "^2.4",
        "spiral/dumper": "^3.3.1",
        "spiral/testing": "^2.12 || ^3.1",
        "vimeo/psalm": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "publish-cmd": "php app.php publish"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "llm/skills": true,
            "spiral/composer-publish-plugin": true
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "php app.php encrypt:key -m .env",
            "php app.php configure --quiet",
            "composer dump-autoload"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv APP_ENV=prod",
            "@putenv DEBUG=false",
            "@putenv VERBOSITY_LEVEL=basic",
            "@putenv TOKENIZER_CACHE_TARGETS=true",
            "@putenv VIEW_CACHE=true",
            "@putenv CYCLE_SCHEMA_CACHE=true",
            "@putenv CYCLE_SCHEMA_WARMUP=true",
            "@php app.php cache:clean",
            "./rr serve"
        ],
        "serve:dev": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv APP_ENV=local",
            "@putenv DEBUG=true",
            "@putenv VERBOSITY_LEVEL=verbose",
            "@putenv TOKENIZER_CACHE_TARGETS=false",
            "@putenv VIEW_CACHE=false",
            "@putenv CYCLE_SCHEMA_CACHE=false",
            "@putenv CYCLE_SCHEMA_WARMUP=false",
            "@putenv MONOLOG_DEFAULT_CHANNEL=remote",
            "@putenv MONOLOG_REMOTE_URL=127.0.0.1:9913",
            "@putenv VAR_DUMPER_FORMAT=server",
            "@putenv VAR_DUMPER_SERVER=127.0.0.1:9912",
            "@putenv MAILER_DSN=smtp://127.0.0.1:1025",
            "@putenv SENTRY_DSN=http://sentry@127.0.0.1:8000/1",
            "@putenv OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318",
            "@putenv OTEL_EXPORTER_OTLP_PROTOCOL=http/json",
            "./rr serve -o \"service.trap.command=php vendor/bin/trap --ui=5007\""
        ],
        "rr:download": "dload get",
        "cs:fix": "php-cs-fixer fix -v",
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "test": "phpunit",
        "test-coverage": "phpunit --coverage"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
