{
    "name": "spiral/app",
    "type": "project",
    "license": "MIT",
    "description": "Spiral Skeleton Application",
    "homepage": "https://spiral.dev",
    "support": {
        "issues": "https://github.com/spiral/app/issues",
        "source": "https://github.com/spiral/app"
    },
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "doctrine/collections": "^3.1",
        "roadrunner/cli": "^3.0.1",
        "spiral-packages/league-event": "^1.0.1",
        "spiral-packages/yii-error-handler-bridge": "^1.1.3",
        "spiral/cycle-bridge": "^2.13",
        "spiral/framework": "^3.18",
        "spiral/nyholm-bridge": "^1.3",
        "spiral/roadrunner-bridge": "^5.0",
        "spiral/stempler-bridge": "^3.18",
        "spiral/translator": "^3.18"
    },
    "require-dev": {
        "llm/skills": "^1.15",
        "spiral/code-style": "^2.4",
        "spiral/dumper": "^3.3.1",
        "spiral/testing": "^3.1",
        "vimeo/psalm": "^6.20"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "publish-cmd": "php app.php publish"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "llm/skills": true,
            "spiral/composer-publish-plugin": true
        }
    },
    "scripts": {
        "post-update-cmd": [
            "php app.php encrypt:key -m .env",
            "php app.php configure --quiet",
            "rr get-binary --quiet",
            "composer dump-autoload"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "rr serve"
        ],
        "rr:download": "rr get-binary",
        "cs:fix": "php-cs-fixer fix -v",
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "test": "phpunit",
        "test-coverage": "phpunit --coverage"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
